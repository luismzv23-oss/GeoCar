<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_start"
        android:enabled="true"
        android:icon="@android:drawable/ic_media_play"
        android:shortcutShortLabel="@string/shortcut_start_short"
        android:shortcutLongLabel="@string/shortcut_start_long">
        <intent
            android:action="com.aistudio.waypulse.SHORTCUT_START"
            android:targetPackage="com.aistudio.waypulse.rtxkzm"
            android:targetClass="com.example.QuickActionActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_stop"
        android:enabled="true"
        android:icon="@android:drawable/ic_media_pause"
        android:shortcutShortLabel="@string/shortcut_stop_short"
        android:shortcutLongLabel="@string/shortcut_stop_long">
        <intent
            android:action="com.aistudio.waypulse.SHORTCUT_STOP"
            android:targetPackage="com.aistudio.waypulse.rtxkzm"
            android:targetClass="com.example.QuickActionActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_sos"
        android:enabled="true"
        android:icon="@android:drawable/ic_dialog_alert"
        android:shortcutShortLabel="@string/shortcut_sos_short"
        android:shortcutLongLabel="@string/shortcut_sos_long">
        <intent
            android:action="com.aistudio.waypulse.SHORTCUT_SOS"
            android:targetPackage="com.aistudio.waypulse.rtxkzm"
            android:targetClass="com.example.QuickActionActivity" />
    </shortcut>
</shortcuts>
